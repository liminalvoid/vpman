// #region Project Definition
Project VpnManager {
    database_type: 'PostgreSQL'
    Note: '''
    # VPN Manager Database Schema
    '''
}
// #endregion

Table configs {
    id         bigint      [pk, increment, note: "Config ID"]
    public_id  uuid        [not null, unique, default: `gen_random_uuid()`, note: "Config's public ID"]
    user_id    bigint      [not null, ref: > users.id, note: "Config's owner"]
    protocol   text        [not null, note: "Config's protocol"]
    status     text        [not null, default: 'active', note: "Config's status"]
    created_at timestamptz [not null, default: `now()`, note: "Config creation date"]
    expires_at timestamptz [not null, note: "Config expiration date"]
    revoked_at timestamptz [note: "Config revocation date"]

    checks {
        `status IN ('active', 'expired', 'revoked')`    [name: 'chk_status_is_known']
        `protocol IN ('awg', 'wg', 'xray', 'hysteria')` [name: 'chk_protocol_is_known'] 
    }

    indexes {
        user_id
    }
}

Table users {
    id            bigint [pk, increment, note: "User ID"]
    public_id     uuid   [not null, unique, default: `gen_random_uuid()`, note: "Public user ID"]
    username      text   [not null, unique, note: "Name of the user"]
    password_hash text   [null, note: "Hash of the password"]
}

Table auth_identities {
    id               bigint [pk, increment, note: "Auth identity entry ID"]
    user_id          bigint [ref: > users.id, not null, note: "User ID"]
    provider         text   [not null, note: "Third-party provider's name"]
    provider_user_id text   [not null, note: "User ID from third-party provider"]

    checks {
        `provider IN ('telegram')` [name: 'chk_provider_is_known']
    }
    
    indexes {
        (provider, provider_user_id) [unique]
        (user_id, provider)          [unique]
        user_id
    }
}

Table sessions {
    id         bigint      [pk, increment, note: "Session ID"]
    user_id    bigint      [not null, ref: > users.id, note: "Session's user ID"]
    token_hash text        [not null, unique, note: "Session token"]
    created_at timestamptz [not null, default: `now()`, note: "Session creation date"]
    expires_at timestamptz [not null, note: "Session expiration date"]

    indexes {
        user_id
    }
}

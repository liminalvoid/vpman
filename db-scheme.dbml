// #region Project Definition
Project VpnManager {
    database_type: 'PostgreSQL'
    Note: '''
    # VPN Manager Database Schema
    '''
}
// #endregion

Table protocols {
    id   smallint [pk, increment]
    name text     [not null, unique]
}

Table configs {
    id           bigint       [pk, increment]
    public_id    uuid         [not null, unique, default: `gen_random_uuid()`]
    name         varchar(255) [not null]
    ip_address   varchar(15)  [not null]
    user_id      bigint       [not null, note: "Config's owner"]
    protocol_id  smallint     [not null]
    server_id    bigint       [not null]
    status       text         [not null, default: 'active', note: "Config's status (active, expired, or revoked)"]
    created_at   timestamptz  [not null, default: `now()`]

    checks {
        `status IN ('active', 'expired', 'revoked')` [name: "chk_status_is_known"]
    }

    indexes {
        user_id
    }
}

Ref: configs.user_id     > users.id     [delete: cascade,  update: no action]
Ref: configs.protocol_id > protocols.id [delete: restrict, update: no action]
Ref: configs.server_id   > servers.id   [delete: restrict, update: no action]

Table users {
    id            bigint  [pk, increment]
    public_id     uuid    [not null, unique, default: `gen_random_uuid()`]
    username      text    [unique]
    telegram_id   bigint  [unique]
    password_hash text
    is_admin      boolean [not null, default: false]
    configs_limit int     [note: "Per-user override of the key quota (NULL = use plan/default)"]

    checks {
        `(username IS NOT NULL AND password_hash IS NOT NULL) OR telegram_id IS NOT NULL` [name: "chk_has_identity"]
        `(username IS NULL) = (password_hash IS NULL)`                                    [name: "chk_username_password_pair"]
        `configs_limit IS NULL OR configs_limit >= 0`                                     [name: "chk_configs_limit_non_negative"]
    }
}

Table subscriptions {
    id                   bigint      [pk, increment]
    user_id              bigint      [not null]
    status               text        [not null]
    current_period_start timestamptz [not null, note: "Start of the subscription period"]
    current_period_end   timestamptz [not null, note: "End of the subscription period"]
    cancel_at_period_end boolean     [not null, default: false, note: "Is subscription cancelled on period end"]
    canceled_at          timestamptz
    created_at           timestamptz [not null, default: `now()`]
    updated_at           timestamptz
    max_configs          int         [not null, note: "Keys included in the plan"]

    checks {
        `status IN ('active', 'trialing', 'past_due', 'canceled', 'incomplete')` [name: "chk_status_is_known"]
    }

    indexes {
        (`(case when status in ('active','trialing') then user_id end)`) [unique, name: "uq_one_active_sub_per_user"]
        user_id
    }
}

Ref: subscriptions.user_id > users.id [delete: cascade, update: no action]

Table servers {
    id               smallint   [pk, increment]
    public_id        uuid       [not null, unique, default: `gen_random_uuid()`]
    public_address   text       [not null]
    internal_address text       [not null]
    location         varchar(2) [not null]
    location_country text       [not null]
    location_city    text       [not null]
}

Table access_codes {
    id         bigint      [pk, increment]
    code       varchar(8)  [not null, unique]
    created_at timestamptz [not null, default: `now()`]
    used_at    timestamptz
}

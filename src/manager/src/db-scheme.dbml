// #region Project Definition
Project VpnManager {
    database_type: 'PostgreSQL'
    Note: '''
    # VPN Manager Database Schema
    '''
}
// #endregion

Table protocols {
    id   smallint [pk, increment]
    name text     [not null, unique]
}

Table configs {
    id           bigint       [pk, increment]
    public_id    uuid         [not null, unique, default: `gen_random_uuid()`]
    name         varchar(255) [not null]
    user_id      bigint       [not null, note: "Config's owner"]
    protocol_id  smallint     [not null]
    status       text         [not null, default: 'active', note: "Config's status (active, expired, or revoked)"]
    location     varchar(2)   [not null, note: "Location of the config"]
    created_at   timestamptz  [not null, default: `now()`]

    checks {
        `status IN ('active', 'expired', 'revoked')` [name: "chk_status_is_known"]
    }

    indexes {
        user_id
    }
}

Ref: configs.user_id     > users.id     [delete: cascade,  update: no action]
Ref: configs.protocol_id > protocols.id [delete: restrict, update: no action]

Table users {
    id            bigint [pk, increment]
    public_id     uuid   [not null, unique, default: `gen_random_uuid()`]
    username      text   [not null, unique]
    password_hash text   [null]
}

Table identity_providers {
    id   smallint [pk, increment]
    name text     [not null, unique]
}

Table auth_identities {
    id               bigint   [pk, increment]
    user_id          bigint   [not null]
    provider_id      smallint [not null, note: "Third-party provider's name"]
    provider_user_id text     [not null, note: "User ID from third-party provider"]

    indexes {
        (provider_id, provider_user_id) [unique]
        (user_id, provider_id)          [unique]
        user_id
    }
}

Ref: auth_identities.user_id     > users.id              [delete: cascade,  update: no action]
Ref: auth_identities.provider_id > identity_providers.id [delete: restrict, update: no action]

Table sessions {
    id         bigint      [pk, increment]
    user_id    bigint      [not null]
    token_hash text        [not null, unique, note: "Session token"]
    created_at timestamptz [not null, default: `now()`]
    expires_at timestamptz [not null]

    indexes {
        user_id
    }
}

Ref: sessions.user_id > users.id [delete: cascade, update: no action]

Table plans {
    id             int        [pk, increment]
    code           text       [not null, unique, note: "Plan's code (e.g. pro_monthly)"]
    name           text       [not null, note: "Plan's name (e.g. Super cool pro plan"]
    amount_cents   int        [not null, note: "Price in US cents"]
    currency       varchar(3) [not null, note: "Price currency"]
    interval       text       [not null]
    interval_count int        [not null, default: 1, note: "Default amount of interval"]
    is_active      boolean    [not null, default: true, note: "Is plan active"]

    checks {
        `interval IN ('second', 'minute', 'hour', 'day', 'week', 'month', 'year')` [name: "chk_interval_is_known"]
    }
}

Table subscriptions {
    id                   bigint      [pk, increment]
    user_id              bigint      [not null]
    plan_id              int         [not null]
    status               text        [not null]
    current_period_start timestamptz [not null, note: "Start of the subscription period"]
    current_period_end   timestamptz [not null, note: "End of the subscription period"]
    cancel_at_period_end boolean     [not null, default: false, note: "Is subscription cancelled on period end"]
    canceled_at          timestamptz
    trial_end            timestamptz [note: "End of the trial"]
    created_at           timestamptz [not null, default: `now()`]
    updated_at           timestamptz [not null, default: `now()`]

    checks {
        `status IN ('active', 'trialing', 'past_due', 'canceled', 'incomplete')` [name: "chk_status_is_known"]
    }

    indexes {
        (`(case when status in ('active','trialing') then user_id end)`) [unique, name: "uq_one_active_sub_per_user"]
        user_id
        plan_id
    }
}

Ref: subscriptions.user_id > users.id [delete: cascade, update: no action]
Ref: subscriptions.plan_id > plans.id [delete: restrict, update: no action]
